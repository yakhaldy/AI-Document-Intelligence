# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_doc_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:@localhost:5432/ai_doc_intelligence

# LLM (extraction, classification zero-shot, agent, génération RAG)
# LLM_PROVIDER : anthropic | gemini
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

# Vector DB
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_DIR=.chroma
QDRANT_URL=
QDRANT_API_KEY=

# Observabilité (coût, latence, traces)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# API
JWT_SECRET=
API_ENV=development
