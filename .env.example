# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_doc_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:@localhost:5432/ai_doc_intelligence

# LLM (extraction, agent, génération RAG)
# LLM_PROVIDER : anthropic | gemini
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

# LLM via OpenRouter (classification LLM zero/few-shot — rapporte un coût
# vérifié par requête, utile pour la comparaison coût/précision de l'Étape 3)
LLM_OPNEROUTER_API_KEY=
LLM_OPNEROUTER_MODEL=openai/gpt-4o-mini

# Jev / TypeSafe AI (System One) — classification zero/few-shot, Étape 3
TYPESAFE_API_KEY=

# Vector DB
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_DIR=.chroma
QDRANT_URL=
QDRANT_API_KEY=

# Observabilité (coût, latence, traces)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# API
JWT_SECRET=
API_ENV=development
