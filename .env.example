# PostgreSQL (docker-compose — dev local uniquement)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_doc_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/ai_doc_intelligence

# Rôle PostgreSQL en lecture seule pour l'agent (README §2.3) — SELECT sur
# v_invoices uniquement, aucun droit sur les tables de base (voir
# db/migrations/versions/*_read_only_agent_role_and_limited_views.py)
AGENT_DB_PASSWORD=
AGENT_DATABASE_URL=postgresql+psycopg://rag_agent:@localhost:5432/ai_doc_intelligence

# LLM Gemini (extraction Étape 2)
# LLM_PROVIDER : anthropic | gemini
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

# LLM via OpenRouter (classification, RAG — génération/reranker/juge, agent)
# — rapporte un coût vérifié par requête, plus fiable que Gemini en pratique
# dans ce projet (503/429 récurrents sur les appels JSON structuré)
LLM_OPNEROUTER_API_KEY=
LLM_OPNEROUTER_MODEL=openai/gpt-4o-mini

# Jev / TypeSafe AI (System One) — classification zero/few-shot, Étape 3
TYPESAFE_API_KEY=

# Observabilité (coût, latence, traces)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# API
JWT_SECRET=
API_ENV=development
# Compte admin de bootstrap (créé par `python -m db.seed_admin`) — seul
# compte pouvant approuver les inscriptions tant qu'aucun autre admin n'existe
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
